  // Old tabs curl at the corners and crack across. The curled corner catches
  // the sun and is what makes an old roof read as old from a helicopter.
  float curl = smoothstep(0.55, 0.95, (1.0 - cf) * (0.5 + 0.6 * rnd.z)) * age;
  h += curl * 0.10;
  ao -= curl * 0.10;
